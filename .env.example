# .env — local overrides for smoke test scripts.
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit it.

# ---------------------------------------------------------------------------
# TLS / Let's Encrypt
# ---------------------------------------------------------------------------

# Email address used for Let's Encrypt certificate registration and renewal
# notices. Required when running any TLS provision: pnpm infra:up:tls followed
# by a pnpm provision:* command, or pnpm infra:ami --domain ...
LETSENCRYPT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# SSH / EC2
# ---------------------------------------------------------------------------

# SSH username on the EC2 instance. Defaults to "ubuntu".
# VNC_USER=ubuntu

# ---------------------------------------------------------------------------
# noVNC ports (provision scripts only)
# ---------------------------------------------------------------------------

# Override the default HTTP and HTTPS ports nginx listens on.
# Defaults: 80 and 443. The custom-ports provision uses 8080/8443.
# NOVNC_HTTP_PORT=80
# NOVNC_HTTPS_PORT=443
