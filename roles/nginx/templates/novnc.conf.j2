map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Redirect all HTTP to HTTPS.
server {
  listen {{ novnc_http_port }} default_server;
  listen [::]:{{ novnc_http_port }} default_server;
  server_name {{ novnc_tls_domain }};

  location / {
    return 301 https://$host{% if (novnc_https_port | int) != 443 %}:{{ novnc_https_port }}{% endif %}$request_uri;
  }
}

server {
  listen {{ novnc_https_port }} ssl http2;
  listen [::]:{{ novnc_https_port }} ssl http2;
  server_name {{ novnc_tls_domain }};

  # Self-signed cert on first provision; certbot updates these paths when viable.
  ssl_certificate     /etc/nginx/ssl/novnc.crt;
  ssl_certificate_key /etc/nginx/ssl/novnc.key;

  ssl_session_timeout 1d;
  ssl_session_cache   shared:MozSSL:10m;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Internal subrequest used by auth_request below.
  # nginx calls this for every request hitting the protected location.
  # The response includes X-VNC-Backend: 127.0.0.1:<port> which nginx
  # captures and uses to route the request to the correct websockify process.
  location = /_auth/verify {
    internal;
    proxy_pass http://127.0.0.1:{{ auth_service_port }}/verify;
    proxy_pass_request_body  off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie            $http_cookie;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
  }

  # Public: receives the token link, sets cookie, redirects to noVNC.
  # This location is intentionally NOT protected by auth_request.
  location = /access {
    proxy_pass http://127.0.0.1:{{ auth_service_port }}/access;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
  }

  # Block external access to the token-generation endpoint.
  location = /generate {
    deny all;
  }

  # Redirect bare root to the noVNC page so authenticated users who land on /
  # (e.g. from an old bookmark) get the desktop rather than a directory listing.
  location = / {
    auth_request /_auth/verify;
    error_page 401 = @unauthorized;
    return 302 /vnc.html?autoconnect=1&resize=remote;
  }

  # Protected: noVNC static files and WebSocket proxy.
  # auth_request_set captures the per-user websockify backend from the
  # X-VNC-Backend response header returned by /verify (e.g. 127.0.0.1:6081).
  # proxy_pass then routes to that backend so each user reaches their own
  # VNC session rather than a shared single backend.
  location / {
    auth_request /_auth/verify;
    auth_request_set $vnc_backend $upstream_http_x_vnc_backend;

    # On auth failure redirect to the access endpoint.
    # The user will need a fresh novnc-desktop-url link.
    error_page 401 = @unauthorized;

    proxy_pass http://$vnc_backend/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host       $host;
    proxy_read_timeout 24h;
    proxy_send_timeout 24h;
  }

  location @unauthorized {
    return 302 /access;
  }
}
