#!/bin/bash
# novnc-rotate-secret — regenerate the novnc-auth HMAC signing secret.
# Run once automatically on first boot via novnc-rotate-secret.service so that
# every instance launched from the same public AMI has a unique secret.
# Safe to run again manually to force rotation.

set -euo pipefail

SECRET_FILE="/etc/novnc-auth/secret"
MARKER="/var/lib/novnc-auth/.secret-rotated"

python3 -c "import secrets; print(secrets.token_hex(32))" > "$SECRET_FILE"
chmod 600 "$SECRET_FILE"
chown novnc-auth:novnc-auth "$SECRET_FILE"

touch "$MARKER"
