[Unit]
Description=Rotate noVNC auth HMAC secret on first boot
# Only runs when the marker file is absent — i.e. exactly once per instance.
ConditionPathExists=!/var/lib/novnc-auth/.secret-rotated
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/novnc-rotate-secret
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
