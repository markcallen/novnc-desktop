[Unit]
Description=Set noVNC auth service base URL from instance metadata
# Runs on every boot; skips when novnc-setup-tls has configured a domain.
After=network-online.target
Wants=network-online.target
Before=novnc-auth.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/novnc-set-base-url
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
