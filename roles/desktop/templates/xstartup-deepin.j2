#!/bin/sh
# Deepin desktop session for VNC (Ubuntu 22.04 / Jammy).
# startdde is the native Deepin session manager; it works correctly on Jammy.
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XDG_CURRENT_DESKTOP=Deepin
export XDG_SESSION_DESKTOP=deepin
export XDG_SESSION_TYPE=x11

dbus-launch --exit-with-session sh -lc "
{% if smoke_test_marker_enabled | bool %}
  xterm -title SMOKE_READY -geometry 44x8+20+20 -bg '#00ff66' -fg black -e sh -lc \"printf 'SMOKE READY\n'; exec sh\" &
{% endif %}
  exec startdde
"
