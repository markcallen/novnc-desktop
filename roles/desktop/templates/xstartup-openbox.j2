#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export DESKTOP_SESSION=xfce
export GTK_THEME=Adwaita

exec dbus-run-session sh -lc "
  xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false || true
  xfconf-query -c xfwm4 -p /general/workspace_count -n -t int -s {{ openbox_desktops }} || true
  xfconf-query -c xfwm4 -p /general/raise_with_any_button -n -t bool -s true || true
  xfconf-query -c xfwm4 -p /general/cycle_minimum -n -t bool -s true || true
  xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s Adwaita || true
  xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s Adwaita || true
  xfconf-query -c xsettings -p /Gtk/FontName -n -t string -s 'Inter 10' || true
  xfconf-query -c xsettings -p /Gtk/MonospaceFontName -n -t string -s 'DejaVu Sans Mono 10' || true
  xfconf-query -c xsettings -p /Xft/HintStyle -n -t string -s hintslight || true
  xfconf-query -c xsettings -p /Xft/RGBA -n -t string -s none || true
  xfconf-query -c xfce4-desktop -p /backdrop/single-workspace-mode -n -t bool -s true || true
  xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual-1/workspace0/image-style -n -t int -s 0 || true
  xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual-1/workspace0/color-style -n -t int -s 0 || true
{% if smoke_test_marker_enabled | bool %}
  (sleep 4; xfce4-terminal --title=SMOKE_READY --geometry=44x8+20+50 --color-bg='#00ff66' --color-text=black --command='sh -lc "printf \"SMOKE READY\n\"; exec sh"') &
{% endif %}
  exec startxfce4
"
