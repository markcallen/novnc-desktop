#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XDG_CURRENT_DESKTOP=Pantheon
export XDG_SESSION_DESKTOP=pantheon
export XDG_SESSION_TYPE=x11

dbus-launch --exit-with-session sh -lc "
  # Unlock GNOME Keyring with an empty password so Chrome and other apps
  # that use libsecret do not prompt for a keyring password in VNC sessions.
  eval \$(echo '' | gnome-keyring-daemon --unlock --components=secrets,pkcs11,ssh 2>/dev/null)
  export GNOME_KEYRING_CONTROL SSH_AUTH_SOCK

  # Keep gala alive for the life of the session. Under llvmpipe it can crash
  # during startup, which leaves Pantheon unrendered even though VNC itself is
  # healthy. The parent PID survives the exec below, so the supervisor exits
  # cleanly when gnome-session ends instead of respawning forever after logout.
  session_pid=\$\$
  (
    while kill -0 \"\$session_pid\" 2>/dev/null; do
      LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe MESA_GL_VERSION_OVERRIDE=3.3 gala --replace
      sleep 2
    done
  ) &

{% if smoke_test_marker_enabled | bool %}
  xterm -title SMOKE_READY -geometry 44x8+20+20 -bg '#00ff66' -fg black -e sh -lc \"printf 'SMOKE READY\n'; exec sh\" &
  (
    # Pantheon's dock often retains focus after session startup under VNC.
    # Re-activate the smoke marker once the shell has mapped so keyboard
    # input works immediately in noVNC.
    for _ in \$(seq 1 30); do
      if wmctrl -a SMOKE_READY 2>/dev/null; then
        break
      fi
      sleep 1
    done
  ) &
{% endif %}

  exec gnome-session --session=pantheon-vnc
"
