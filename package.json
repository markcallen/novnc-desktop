{
  "name": "novnc-desktop",
  "version": "0.1.5",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Playwright smoke test suite for novnc-desktop",
  "scripts": {
    "build:ami": "./build-ami.sh",
    "build:ami:public": "AMI_PUBLIC=true AMI_ENVIRONMENT=production ./build-ami.sh",
    "infra:up": "bash smoke/scripts/infra-up.sh",
    "infra:up:tls": "bash smoke/scripts/infra-up-tls.sh",
    "infra:ami": "bash smoke/scripts/infra-ami.sh",
    "infra:ami:elementary": "bash smoke/scripts/infra-ami.sh --variant elementary",
    "infra:ami:elementary:custom-ports": "bash smoke/scripts/infra-ami.sh --variant elementary --http-port 8080 --https-port 8443",
    "infra:ami:elementary:custom-ports:public": "bash smoke/scripts/infra-ami.sh --variant elementary --http-port 8080 --https-port 8443 --public",
    "infra:status": "bash smoke/scripts/infra-status.sh",
    "infra:down": "bash smoke/scripts/infra-down.sh",
    "provision:openbox": "bash smoke/scripts/provision-openbox.sh",
    "provision:elementary": "bash smoke/scripts/provision-elementary.sh",
    "provision:elementary:custom-ports": "bash smoke/scripts/provision-elementary-custom-ports.sh",
    "test": "playwright test",
    "test:unit": "node --test smoke/unit/helpers.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.3"
  }
}
